<?xml version="1.0" encoding="utf-8"?>
<!--
  Patch 33: status-bar glyph of the small old television from the launcher icon.

  Notification small icons are drawn from their alpha channel only, so this is a single-colour
  silhouette: the screen and the two knobs are cut out with the even-odd fill rule, the
  antennas and the feet are separate solid shapes. It replaces ic_download (an arrow) on the
  strategy-search and bypass notifications, where an arrow made the app look like it was
  downloading. Real download notifications keep the download glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Cabinet with the screen and two knobs cut out -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M5,6 H19 A2,2 0 0 1 21,8 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V8 A2,2 0 0 1 5,6 Z M6.5,8.5 H14.5 A1,1 0 0 1 15.5,9.5 V15.5 A1,1 0 0 1 14.5,16.5 H6.5 A1,1 0 0 1 5.5,15.5 V9.5 A1,1 0 0 1 6.5,8.5 Z M17.3,10 A0.9,0.9 0 1 0 19.1,10 A0.9,0.9 0 1 0 17.3,10 Z M17.3,14 A0.9,0.9 0 1 0 19.1,14 A0.9,0.9 0 1 0 17.3,14 Z" />
    <!-- Antennas and feet -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,2.4 L8.2,1.6 L12,5.4 L11,6.4 Z M17,2.4 L15.8,1.6 L12,5.4 L13,6.4 Z M5.5,19 H8 V21 H5.5 Z M16,19 H18.5 V21 H16 Z" />
</vector>
